# GH Motive Backend — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env with real secrets

# ─── Application ───────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# ─── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/gh_motive_dev?schema=public"

# ─── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ───────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# ─── Bcrypt ────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ─── Rate Limiting ─────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@ghmotive.com

# ─── SMS (Arkesel) ─────────────────────────────────────────────
# Active provider: arkesel | mock
# MOCK is blocked in production regardless of this value
# Docs: https://developers.arkesel.com
# Dashboard: https://sms.arkesel.com
SMS_PROVIDER=mock
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=GHMotive
ARKESEL_SANDBOX=false

# ─── File Storage ──────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
# For production S3/R2:
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET_NAME=
# AWS_REGION=

# ─── Payment Provider ──────────────────────────────────────────
# Active provider: HUBTEL_DIRECTPAY | MTN_DIRECT_P2P | MOCK
# Overridden at runtime via Admin → Payment Provider settings
# MOCK is blocked in production regardless of this value
PAYMENT_ACTIVE_PROVIDER=MOCK

# ─── Hubtel DirectPay ──────────────────────────────────────────
# Docs: https://developers.hubtel.com/docs/directpay
# Get credentials from: https://unity.hubtel.com/
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=GHMotive
HUBTEL_CALLBACK_URL=http://localhost:3001/api/v1/payments/webhooks/hubtel

# ─── MTN MoMo Direct P2P ───────────────────────────────────────
# Docs: https://momodeveloper.mtn.com/
# Sandbox: https://sandbox.momodeveloper.mtn.com/
MTN_ENVIRONMENT=sandbox
# Collections API (debit driver's wallet)
MTN_COLLECTION_PRIMARY_KEY=
MTN_COLLECTION_API_USER_ID=
MTN_COLLECTION_API_KEY=
MTN_COLLECTION_CALLBACK_URL=http://localhost:3001/api/v1/payments/webhooks/mtn
# Disbursements API (credit owner's wallet)
MTN_DISBURSEMENT_PRIMARY_KEY=
MTN_DISBURSEMENT_API_USER_ID=
MTN_DISBURSEMENT_API_KEY=
MTN_DISBURSEMENT_CALLBACK_URL=http://localhost:3001/api/v1/payments/webhooks/mtn

# ─── Push Notifications (Expo) ─────────────────────────────────
# Expo push notifications are delivered via expo-server-sdk + BullMQ.
# No additional API key is needed for Expo push — authentication is
# handled per-token. Redis must be running for the queue to work.
# Register tokens via: POST /api/v1/notifications/push-token
# Deactivate tokens via: DELETE /api/v1/notifications/push-token/:token

# ─── Application URL ───────────────────────────────────────────
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
