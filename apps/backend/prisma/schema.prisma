// GH Motive — Prisma Schema
// PostgreSQL + Prisma
// Phase 1: Foundation — Users, Auth, Roles, Drivers, Owners, Companies, Vehicles

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMERATIONS
// ─────────────────────────────────────────────────────────────

enum UserRole {
  PENDING
  DRIVER
  OWNER
  COMPANY_ADMIN
  COMPANY_MEMBER
  FLEET_MANAGER
  SERVICE_PROVIDER
  LEGAL_PROFESSIONAL
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum GenderType {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum IdentityDocumentType {
  GHANA_CARD
  PASSPORT
  VOTERS_ID
  DRIVERS_LICENSE
}

enum CompanyType {
  TRANSPORT
  FLEET_MANAGEMENT
  VEHICLE_PLACEMENT
  MAINTENANCE
  LEGAL_DISPUTE_RESOLUTION
}

enum CompanyStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum DriverStatus {
  PENDING_VERIFICATION
  VERIFIED
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OwnerStatus {
  PENDING_VERIFICATION
  VERIFIED
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum VehicleVerificationStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum VehicleStatus {
  DRAFT
  PENDING_VERIFICATION
  AVAILABLE
  PENDING_ASSIGNMENT
  ASSIGNED
  ACTIVE
  UNDER_MAINTENANCE
  SUSPENDED
  IN_DISPUTE
  COMPLETED_WORK_AND_PAY
  OWNERSHIP_TRANSFER_PENDING
  TRANSFERRED
  ARCHIVED
}

enum OperatingModel {
  WORK_AND_PAY
  RENTAL
  DRIVING_ON
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  LPG
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
}

enum VehicleType {
  SEDAN
  SUV
  PICKUP
  VAN
  MINIBUS
  BUS
  TRUCK
  TRAILER
  MOTORCYCLE
  TRICYCLE
  OTHER
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum ContractType {
  WORK_AND_PAY
  RENTAL
  DRIVING_ON
  FLEET_MANAGEMENT
  VEHICLE_PLACEMENT
  MAINTENANCE_SERVICE
  LEGAL_SERVICE
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURES
  ACTIVE
  SUSPENDED
  TERMINATED
  EXPIRED
  COMPLETED
  IN_DISPUTE
}

enum PaymentObligationType {
  INSTALLMENT
  DAILY_SALES
  WEEKLY_SALES
  MANAGEMENT_FEE
  PLACEMENT_FEE
  MAINTENANCE_FEE
  SERVICE_FEE
}

enum PaymentStatus {
  INITIATED
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  REVERSED
  REFUNDED
  DISPUTED
  SETTLED
}

enum TransactionType {
  PAYMENT_IN
  PAYMENT_OUT
  FEE
  REFUND
  REVERSAL
  ADJUSTMENT
  SETTLEMENT
}

enum TransactionDirection {
  DEBIT
  CREDIT
}

enum SettlementStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MaintenanceStatus {
  REQUESTED
  APPROVED
  SCHEDULED
  IN_PROGRESS
  WAITING_FOR_PARTS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  EVIDENCE_REQUESTED
  AWAITING_RESPONSE
  MEDIATION
  ESCALATED
  RESOLVED
  CLOSED
  REOPENED
}

enum TrackingDeviceStatus {
  ACTIVE
  INACTIVE
  OFFLINE
  FAULT
}

enum IncidentType {
  ACCIDENT
  BREAKDOWN
  THEFT
  DAMAGE
  TRAFFIC
  OTHER
}

enum IncidentStatus {
  REPORTED
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum ComplianceDocumentType {
  INSURANCE
  ROADWORTHINESS
  VEHICLE_REGISTRATION
  DRIVER_LICENSE
  BUSINESS_LICENSE
  OTHER
}

enum ComplianceStatus {
  VALID
  EXPIRING_SOON
  EXPIRED
  PENDING_RENEWAL
}

enum NotificationChannel {
  IN_APP
  SMS
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
